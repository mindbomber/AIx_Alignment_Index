AIX_ENVIRONMENT=development
POSTGRES_PASSWORD=replace-for-shared-environments
AIX_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AIX_SESSION_IDLE_MINUTES=60
AIX_SESSION_TOUCH_INTERVAL_SECONDS=300
AIX_MAX_SESSIONS_PER_USER=10
AIX_WEBHOOK_SECRET_PEPPER=replace-with-at-least-32-random-characters
AIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINIO_ROOT_USER=aix-local
MINIO_ROOT_PASSWORD=replace-with-a-long-local-secret
VITE_API_URL=http://localhost:8000

# Distributed jobs
# AIX_REDIS_URL=redis://localhost:6379/0
# AIX_JOB_QUEUE_NAME=aix:jobs
# AIX_JOB_RETRY_BASE_SECONDS=5

# Malware scanning (production should use a reachable clamd service)
# AIX_MALWARE_SCAN_ENABLED=true
# AIX_MALWARE_SCAN_BACKEND=clamd
# AIX_MALWARE_SCAN_HOST=127.0.0.1
# AIX_MALWARE_SCAN_PORT=3310

# S3 encryption (use aws:kms plus a key id for a customer-managed key)
# AIX_S3_SERVER_SIDE_ENCRYPTION=AES256
# AIX_S3_KMS_KEY_ID=

# Optional enterprise identity
# AIX_OIDC_ISSUER=https://identity.example.com
# AIX_OIDC_CLIENT_ID=aix
# AIX_OIDC_CLIENT_SECRET=replace-me
# AIX_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/oidc/callback
# AIX_OIDC_WEB_APP_URL=http://localhost:5173
# AIX_OIDC_AUTO_PROVISION=false
# AIX_OIDC_DEFAULT_ROLE=viewer
# AIX_OIDC_ROLE_CLAIM=aix_role

# Optional telemetry
# AIX_OTLP_ENDPOINT=http://otel-collector:4318
