# GitHub staging acceptance account
AIX_E2E_ORG=aix-staging
AIX_E2E_EMAIL=owner@example.com
AIX_E2E_PASSWORD=replace-with-a-strong-unique-password

# AIx application configuration
AIX_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/aix
POSTGRES_PASSWORD=replace-with-a-strong-database-password
AIX_REDIS_URL=redis://HOST:6379/0
AIX_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AIX_WEBHOOK_SECRET_PEPPER=replace-with-at-least-32-random-characters
AIX_CORS_ORIGINS=https://YOUR-STAGING-WEB-HOST

# Evidence storage
AIX_S3_BUCKET=aix-staging-evidence
AIX_S3_REGION=us-east-1
AIX_S3_ENDPOINT_URL=
AIX_S3_ACCESS_KEY_ID=
AIX_S3_SECRET_ACCESS_KEY=
AIX_S3_SERVER_SIDE_ENCRYPTION=
AIX_S3_KMS_KEY_ID=

# Optional telemetry and OIDC
AIX_OTLP_ENDPOINT=
AIX_OIDC_ISSUER=
AIX_OIDC_CLIENT_ID=
AIX_OIDC_CLIENT_SECRET=
AIX_OIDC_REDIRECT_URI=
AIX_OIDC_WEB_APP_URL=
